# Copy to ".env" and fill in before deploying. Never commit the real .env.
#
# These are read by config/settings.py via os.environ. Nothing here is required
# for local development -- the defaults keep the project runnable as-is.
#
# On Windows (PowerShell), set one for the current session with:
#     $env:DJANGO_DEBUG = "0"
# On Linux/macOS:
#     export DJANGO_DEBUG=0


# ==================================================
# CORE
# ==================================================

# Generate a fresh one before going live:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 1 during development, 0 in production.
DJANGO_DEBUG=1

# Required once DJANGO_DEBUG=0. Comma separated, no scheme.
DJANGO_ALLOWED_HOSTS=


# ==================================================
# SMS
# ==================================================

# Which gateway carries the messages.
#   complaint.sms.ConsoleSMSBackend  -> prints to the terminal, sends nothing
#   complaint.sms.SparrowSMSBackend  -> sparrowsms.com
#   complaint.sms.AakashSMSBackend   -> aakashsms.com
SMS_BACKEND=complaint.sms.ConsoleSMSBackend

# Master switch. 0 stops all sending without touching any code.
SMS_ENABLED=1

# Seconds to wait on the gateway before giving up.
SMS_TIMEOUT=10

# Sparrow SMS credentials. SPARROW_SMS_FROM is the registered sender identity.
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# Aakash SMS credentials.
AAKASH_SMS_TOKEN=
